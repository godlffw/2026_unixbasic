CC = gcc
CFLAGS = -Wall -Iinclude -MMD 
//header 경로 MMD : .d file 생성 (generate dependency files)
//include header files in the dependency

SRC = src/main.c src/add.c 
// == SRC = src/main.c src/add.c

OBJ = $(SRC:.c=.o) #문자열 치환


.PHONY: all clean

app: $(OBJ)
	$(CC) $(CFLAGS) $^ -o $@

%.o : %.c %.h
	$(CC) $(CFLAGS) -c $<

clean:
	rm -rf app *.o

helloTest: abc def
	@echo $<
abc:
